# aiping 代理（OpenAI/Anthropic 兼容）
OPENAI_BASE_URL=https://aiping.cn/api/v1
ANTHROPIC_BASE_URL=https://aiping.cn/api/v1/anthropic
# 你的 QC API Key，形如 QC-xxxx 仅本地 .env，勿提交
AIPING_API_KEY=QC-xxx

# LLM 选型（廉价主力 + 高质量）
LLM_CHEAP=DeepSeek-V3.2
LLM_QUALITY=DeepSeek-V3

# 生图三轨（已验证价格）
IMAGE_MODEL_HERO=doubao-seedream-4.0
IMAGE_MODEL_DIAGRAM=kling-v2.1
IMAGE_MODEL_BG=kolors

# 价格参考（aiping /v1/models 实测 2026-08-27）
# Kolors ¥0 | Kling-V2.1 ¥0.10 | Doubao-4.0 ¥0.20 | Qwen-Image 0.145-0.3

# ─────────────────────────────────────────────────────────────
# 四方向新闻工作流外部依赖（审查结论 2026-08-29，全部免费）
# ─────────────────────────────────────────────────────────────
# GitHub PAT（必配：未认证 60次/时，配后 5000次/时，83 倍）
# GitHub → Settings → Developer settings → Personal access tokens → 只勾 public_repo 读权限
GITHUB_TOKEN=

# TMDB API Key（娱乐方向必配：免费、无付费档、40 req/10s）
# themoviedb.org 注册 → Settings → API → Request API Key → 选 Developer（非 Commercial）
TMDB_API_KEY=

# 热榜/资讯（免费，无需配 key，直接用公共端点）
# 60s API：60s.viki.moe/v2/{weibo,zhihu,ai-news,maoyan,douyin,...}（MIT 开源，免部署）
# DailyHotApi：自部署 docker imsyy/dailyhot-api:latest -p 6688（备援）

# X/Twitter（免费、免 API key、免会员）
# 不配官方 API（2026-02 后免费层已死，按量付费）。用 x-tweet-fetcher：
#   - FxTwitter 公开 API 免登录抓单帖
#   - x_discover.py 用 DuckDuckGo 免 key 按关键词发现推文
# 备援 cookie（登录 x.com → F12 → Application → Cookies → auth_token，用专用小号）
X_AUTH_TOKEN=
