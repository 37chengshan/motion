# aiping 代理（OpenAI/Anthropic 兼容）
OPENAI_BASE_URL=https://aiping.cn/api/v1
ANTHROPIC_BASE_URL=https://aiping.cn/api/v1/anthropic
# 你的 QC API Key，形如 QC-xxxx 仅本地 .env，勿提交
AIPING_API_KEY=QC-xxx

# LLM 选型（廉价主力 + 高质量）
LLM_CHEAP=DeepSeek-V3.2
LLM_QUALITY=DeepSeek-V3

# 生图三轨（已验证价格）
IMAGE_MODEL_HERO=doubao-seedream-4.0
IMAGE_MODEL_DIAGRAM=kling-v2.1
IMAGE_MODEL_BG=kolors

# 价格参考（aiping /v1/models 实测 2026-08-27）
# Kolors ¥0 | Kling-V2.1 ¥0.10 | Doubao-4.0 ¥0.20 | Qwen-Image 0.145-0.3
