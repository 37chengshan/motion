{
  "name": "vido",
  "version": "1.0.0",
  "description": "Vido - 每日视频工作流：AI新闻日报 / 开源项目介绍 / 自有项目宣传 / 真人录屏",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render",
    "render:short": "npx remotion render VidoShort out/video_short.mp4",
    "render:long": "npx remotion render VidoLong out/video_long.mp4",
    "render:all": "node scripts/render-batch.ts",
    "render:burned": "ffmpeg -i out/video_short.mp4 -vf \"subtitles=out/subtitle.srt:force_style='FontSize=24,PrimaryColour=&HFFFFFF&,OutlineColour=&H000000&,Outline=2,MarginV=60'\" -c:a copy out/video_short_burned.mp4",
    "login": "node scripts/platform-login.ts",
    "login:check": "node scripts/platform-login.ts --check",
    "publish": "node scripts/publish.ts",
    "dashboard": "node dashboard/server.ts",
    "dashboard:add": "node scripts/dashboard-add.ts",
    "accounts": "node scripts/account-list.ts",
    "review:video": "node scripts/review-video.ts",
    "research": "node scripts/daily-research.ts",
    "score": "node scripts/score-and-rank.ts",
    "tts": "python scripts/tts-cosyvoice.py",
    "timeline": "node scripts/prepare-audio.ts",
    "srt": "node scripts/gen-srt.ts",
    "upgrade": "npx remotion upgrade"
  },
  "dependencies": {
    "@remotion/animation-utils": "^4.0.0",
    "@remotion/captions": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/light-leaks": "^4.0.0",
    "@remotion/lottie": "^4.0.0",
    "@remotion/motion-blur": "^4.0.0",
    "@remotion/noise": "^4.0.0",
    "@remotion/paths": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "@remotion/rive": "^4.0.0",
    "@remotion/shapes": "^4.0.0",
    "@remotion/tailwind-v4": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "lottie-web": "^5.12.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "remotion-animated": "^1.0.0",
    "rough-notation": "^0.5.1",
    "tailwindcss": "^4.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.0"
  }
}
